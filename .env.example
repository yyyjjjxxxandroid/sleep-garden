# Run npm start. Keep credentials on the server; never paste them into source.html.
PORT=8766
AI_MODEL=gpt-5.6-sol

# Project credential, independent of each teammate's Codex installation.
# Each teammate supplies their own key; do not commit or paste real keys here.
AI_USE_CODEX_PROVIDER=false
AI_BASE_URL=https://code.ylsagi.com/codex
AI_WIRE_API=responses
AI_API_KEY=

# For another provider, replace the API base URL, model and key together:
# AI_BASE_URL=https://your-provider.example/v1
# AI_API_KEY=your-api-key
# For a Chat Completions compatible service use AI_WIRE_API=chat.

# Optional local-only fallback: AI_USE_CODEX_PROVIDER=true reads the selected
# provider's ordinary API token from ~/.codex/config.toml (not login tokens).
